{
  "name": "seelig-pdf",
  "version": "1.0.0",
  "private": true,
  "description": "100% client-side, security-hardened PDF toolkit in Seelig Designs look",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "node scripts/preview-secure.mjs",
    "test": "vitest run",
    "audit:security": "node scripts/security-audit.mjs",
    "test:e2e": "playwright test",
    "verify:all": "npm test && npm run build && npm run audit:security && npm run test:e2e"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@fontsource/lexend": "5.3.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@tauri-apps/plugin-updater": "2.14.1",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.5.438",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.6",
    "jsdom": "26.1.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
